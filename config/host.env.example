# Copy to config/local/host.env on each mini and adjust for the host resources.
# This file contains no secrets.

# Work host with 64 GB RAM:
# DEV_MACHINE_MEMORY=32G

# Leave empty to share OrbStack's global CPU limit dynamically.
DEV_MACHINE_CPUS=

# Defaults are intentionally conservative and can be overridden here.
# DEV_MACHINE_DISK=300G
# DEV_EXPERIMENT_MEMORY=8G

# A predictable external volume name is needed only for backup/export commands.
DEV_EXTERNAL_VOLUME=DevArchive
