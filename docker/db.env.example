# Copy to ~/.config/dev-machine/db.env inside each development machine.
# Keep the real file private and mode 0600. Values below are placeholders.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-local-only-password
POSTGRES_DB=app
POSTGRES_PORT=5432

MSSQL_SA_PASSWORD=Replace-With-A-Strong-Local-Only-Password-1
MSSQL_PORT=1433

REDIS_PASSWORD=replace-with-a-local-only-password
REDIS_PORT=6379

