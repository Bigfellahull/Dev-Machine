# Runtime image versions are updated deliberately. Database data is isolated by
# the Compose project name chosen by bin/db.
POSTGRES_IMAGE=postgres:18.6
REDIS_IMAGE=redis:8.10.0

# Microsoft publishes SQL Server only for x86-64. On Apple Silicon this runs
# under OrbStack translation and is not a Microsoft-supported configuration.
MSSQL_IMAGE=mcr.microsoft.com/mssql/server:2025-latest

